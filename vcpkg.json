{
  "name": "i18n-redis",
  "version-string": "1.3.1-SNAPSHOT",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    {
      "name": "redis-plus-plus",
      "features": [
        "cxx17",
        "async"
      ]
    },
    "fmt"
  ],
  "features": {
    "tests": {
      "description": "Build and run the test suite with Catch2",
      "dependencies": [
        "catch2"
      ]
    },
    "simdjson": {
      "description": "Build with simdjson support for faster JSON parsing and reading",
      "dependencies": [
        {
          "name": "simdjson",
          "features": [
            "exceptions",
            "utf8-validation",
            "threads"
          ]
        }
      ]
    },
    "yyjson": {
      "description": "Build with yyjson support for faster JSON parsing and reading",
      "dependencies": [
        {
          "name": "yyjson",
          "features": [
            "reader",
            "writer"
          ]
        }
      ]
    }
  }
}
