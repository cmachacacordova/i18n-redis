#!/bin/bash
# Configure and build script for i18n-redis
# Usage: ./configure [--preset <name> | -p <name>] [--use-vcpkg] [-- <cmake-args>...]
#   --preset, -p <name>  Use specific CMake preset
#   --use-vcpkg          Use vcpkg for dependency management
#   --configure-only     Only configure, don't build
#   -- <cmake-args>      Extra arguments forwarded to cmake (e.g. -DFOO=BAR)
# If no preset specified, shows interactive selection menu

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$SCRIPT_DIR"
VCPKG_DIR=""
PRESET_MODE=false
USE_VCPKG=false

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

info() {
    if [[ "$PRESET_MODE" == true ]]; then
        return 0
    fi

    echo -e "${GREEN}[INFO]${NC} $1"
}

progress() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

run_with_info_prefix() {
    "$@" 2>&1 | while IFS= read -r line; do
        progress "$line"
    done

    return "${PIPESTATUS[0]}"
}

warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

die() {
    error "$1"
    exit 1
}

# Parse command line arguments
PRESET=""
CONFIGURE_ONLY=false
CMAKE_ARGS=()

parse_args() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            --preset|-p)
                [[ $# -ge 2 ]] || die "Missing value for $1"
                PRESET="$2"
                PRESET_MODE=true
                shift 2
                ;;
            --use-vcpkg)
                USE_VCPKG=true
                shift
                ;;
            --configure-only)
                CONFIGURE_ONLY=true
                shift
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            --)
                shift
                CMAKE_ARGS=("$@")
                break
                ;;
            -D*|-U*|-G*|-T*|-A*)
                CMAKE_ARGS+=("$1")
                shift
                ;;
            *)
                warn "Unknown option: $1"
                shift
                ;;
        esac
    done
}

show_help() {
    cat << 'EOF'
Configure and build i18n-redis

Usage: ./configure [OPTIONS]

Options:
  -p, --preset <name>   Use specific CMake preset
  --use-vcpkg           Use vcpkg for dependency management
  --configure-only      Only configure, don't build
  -h, --help            Show this help message
  -- <cmake-args>       Extra arguments forwarded to cmake configure step

Examples:
  ./configure                                        # Interactive mode (system deps)
  ./configure -p linux-gcc-static-release --use-vcpkg # Use vcpkg
  ./configure --preset linux-gcc-static-release -- -DFOO=BAR -DBAZ=1
  ./configure -p linux-gcc-static-release -DFOO=BAR

Available presets can be found in CMakePresets.json
EOF
}

# Check whether the current directory is a git repository
is_git_repo() {
    local candidate=$1
 
    [[ -d "$candidate/.git" ]] || git -C "$candidate" rev-parse --git-dir > /dev/null 2>&1
}

# Check whether a vcpkg root looks usable by CMake.
is_vcpkg_source_dir() {
    local candidate=$1

    [[ -n "$candidate" ]] || return 1
    [[ -d "$candidate" ]] || return 1
    [[ -f "$candidate/scripts/buildsystems/vcpkg.cmake" ]] || return 1
    [[ -f "$candidate/bootstrap-vcpkg.sh" || -f "$candidate/bootstrap-vcpkg.bat" ]] || return 1
}

# Check whether a vcpkg root already has the vcpkg executable.
is_bootstrapped_vcpkg_dir() {
    local candidate=$1

    is_vcpkg_source_dir "$candidate" || return 1

    if [[ "$OSTYPE" == "msys" ]] || [[ "$OSTYPE" == "cygwin" ]] || [[ "$OSTYPE" == "win32" ]]; then
        [[ -f "$candidate/vcpkg.exe" ]] || return 1
    else
        [[ -f "$candidate/vcpkg" ]] || return 1
    fi
}

# Initialize vcpkg submodule when in git repository
init_vcpkg_submodule() {
    info "Git repository detected. Updating vcpkg submodule..."
    git submodule update --init --recursive extras/vcpkg
    info "vcpkg submodule initialized successfully."
}

# Initialize registry submodule when needed for custom triplets
init_registry_submodule() {
    local registry_dir="$PROJECT_ROOT/extras/registry"

    if [ -d "$registry_dir/.git" ] || [ -f "$registry_dir/triplets/x64-linux-dynamic.cmake" ]; then
        info "Registry already available at $registry_dir"
        return 0
    fi

    if is_git_repo "$PROJECT_ROOT"; then
        info "Initializing registry submodule..."
        git submodule update --init extras/registry
        if [ $? -eq 0 ]; then
            info "Registry submodule initialized successfully."
        else
            warn "Failed to initialize registry submodule. Will try to clone..."
            clone_registry
        fi
    else
        clone_registry
    fi
}

# Clone registry directly when no git repository
clone_registry() {
    local registry_dir="$PROJECT_ROOT/extras/registry"

    if [ -d "$registry_dir/.git" ]; then
        info "Registry already exists at $registry_dir"
        return 0
    fi

    if [ -d "$registry_dir" ]; then
        warn "Registry directory exists but is not a git repo. Removing..."
        rm -rf "$registry_dir"
    fi

    info "Cloning vcpkg-registry from GitHub..."
    git clone --depth=1 -b vcpkg https://github.com/cmachacacordova/vcpkg-registry.git "$registry_dir"
    info "Registry cloned successfully."
}

# List of custom triplets that require the overlay registry
get_custom_triplets() {
    echo "x64-linux-dynamic x64-linux-clang x64-linux-clang-dynamic x64-linux-one-api x64-linux-one-api-dynamic x64-osx-dynamic"
}

# Check if a triplet requires the overlay registry
is_custom_triplet() {
    local triplet="$1"
    local custom_triplets
    custom_triplets=$(get_custom_triplets)

    for custom in $custom_triplets; do
        if [ "$triplet" = "$custom" ]; then
            return 0
        fi
    done
    return 1
}

# Extract VCPKG_TARGET_TRIPLET from a preset
get_preset_triplet() {
    local preset="$1"

    # Query cmake for the VCPKG_TARGET_TRIPLET cache variable
    local triplet
    triplet=$(cmake --preset "$preset" 2>/dev/null | grep -oP 'VCPKG_TARGET_TRIPLET=\K[^ ]+' | head -1)

    # If not found via cmake, try parsing CMakePresets.json directly
    if [ -z "$triplet" ]; then
        triplet=$(grep -A 20 '"name": "'"$preset"'"' "$PROJECT_ROOT/CMakePresets.json" 2>/dev/null | \
                  grep -oP '"VCPKG_TARGET_TRIPLET": "\K[^"]+' | head -1)
    fi

    echo "$triplet"
}

# Clone vcpkg directly when no git repository (source distribution)
clone_vcpkg() {
    local vcpkg_dir="$PROJECT_ROOT/extras/vcpkg"

    if [ -d "$vcpkg_dir/.git" ]; then
        info "vcpkg already exists at $vcpkg_dir"
        return 0
    fi

    if [ -d "$vcpkg_dir" ]; then
        warn "vcpkg directory exists but is not a git repo. Removing..."
        rm -rf "$vcpkg_dir"
    fi

    info "Cloning vcpkg from GitHub..."
    git clone --depth=1 https://github.com/microsoft/vcpkg.git "$vcpkg_dir"
    info "vcpkg cloned successfully."
}

# Detect vcpkg from VCPKG_HOME first, then obtain a local copy when needed.
resolve_vcpkg() {
    if [[ -n "${VCPKG_HOME:-}" ]]; then
        if is_bootstrapped_vcpkg_dir "$VCPKG_HOME"; then
            VCPKG_DIR="$VCPKG_HOME"
            info "Using vcpkg from VCPKG_HOME: $VCPKG_DIR"
            return 0
        fi

        if is_vcpkg_source_dir "$VCPKG_HOME"; then
            VCPKG_DIR="$VCPKG_HOME"
            info "Using vcpkg source from VCPKG_HOME: $VCPKG_DIR"
            return 0
        fi

        warn "VCPKG_HOME is set but does not point to a valid vcpkg root: $VCPKG_HOME"
    fi

    VCPKG_DIR="$PROJECT_ROOT/extras/vcpkg"

    if is_bootstrapped_vcpkg_dir "$VCPKG_DIR"; then
        info "Using local vcpkg from $VCPKG_DIR"
        return 0
    fi

    if is_git_repo "$PROJECT_ROOT"; then
        init_vcpkg_submodule
    else
        if is_vcpkg_source_dir "$VCPKG_DIR"; then
            info "Using local vcpkg source from $VCPKG_DIR"
        else
            clone_vcpkg
        fi
    fi
}

# Bootstrap vcpkg
bootstrap_vcpkg() {
    local vcpkg_dir="$VCPKG_DIR"
    local vcpkg_exe="$vcpkg_dir/vcpkg"

    if [[ "$OSTYPE" == "msys" ]] || [[ "$OSTYPE" == "cygwin" ]] || [[ "$OSTYPE" == "win32" ]]; then
        vcpkg_exe="$vcpkg_dir/vcpkg.exe"
    fi

    if [[ -f "$vcpkg_exe" ]]; then
        info "vcpkg is already bootstrapped."
        return 0
    fi

    if [[ "$OSTYPE" == "msys" ]] || [[ "$OSTYPE" == "cygwin" ]] || [[ "$OSTYPE" == "win32" ]]; then
        # Windows
        local bootstrap_bat="$vcpkg_dir/bootstrap-vcpkg.bat"
        if [ -f "$bootstrap_bat" ]; then
            info "Bootstrapping vcpkg (Windows)..."
            "$bootstrap_bat" -disableMetrics
        else
            die "vcpkg bootstrap script not found at $bootstrap_bat"
        fi
    else
        # Unix (Linux/macOS)
        local bootstrap_sh="$vcpkg_dir/bootstrap-vcpkg.sh"
        if [ -f "$bootstrap_sh" ]; then
            info "Bootstrapping vcpkg (Unix)..."
            "$bootstrap_sh" -disableMetrics
        else
            die "vcpkg bootstrap script not found at $bootstrap_sh"
        fi
    fi

    info "vcpkg bootstrapped successfully."
}

# Detect platform
detect_platform() {
    local platform
    if [[ "$OSTYPE" == "linux-gnu"* ]]; then
        platform="linux"
    elif [[ "$OSTYPE" == "darwin"* ]]; then
        platform="macos"
    elif [[ "$OSTYPE" == "msys" ]] || [[ "$OSTYPE" == "cygwin" ]] || [[ "$OSTYPE" == "win32" ]]; then
        platform="windows"
    else
        platform="unknown"
    fi
    echo "$platform"
}

# Interactive preset selection using CMake's preset discovery.
select_preset_interactive() {
    local platform
    platform=$(detect_platform)

    echo ""
    echo "========================================"
    echo "Available presets for $platform:"
    echo "========================================"

    declare -a preset_names
    declare -a preset_displays
    local count=0

    while IFS='|' read -r name display_name; do
        [[ -z "$name" ]] && continue
        case "$platform" in
            linux) [[ "$name" == linux-* ]] || continue ;;
            windows) [[ "$name" == windows-* ]] || continue ;;
            macos) [[ "$name" == macos-* ]] || continue ;;
        esac

        preset_names[$count]="$name"
        preset_displays[$count]="$display_name"
        ((++count))
    done < <(list_configure_presets)

    if [[ ${#preset_names[@]} -eq 0 ]]; then
        die "No presets found. Make sure CMakePresets.json exists and is valid. (platform: $platform)"
    fi

    # Display presets
    for i in "${!preset_names[@]}"; do
        printf "  %2d) %-40s %s\n" $((i+1)) "${preset_names[$i]}" "${preset_displays[$i]}"
    done

    echo ""
    echo "========================================"

    # Ask user to select
    while true; do
        read -rp "Select preset (1-${#preset_names[@]}): " selection
        if [[ "$selection" =~ ^[0-9]+$ ]] && (( selection >= 1 && selection <= ${#preset_names[@]} )); then
            PRESET="${preset_names[$((selection-1))]}"
            break
        else
            warn "Invalid selection. Please enter a number between 1 and ${#preset_names[@]}"
        fi
    done
}

# List visible configure presets as "name|display name".
list_configure_presets() {
    cmake --list-presets=configure |
        sed -n 's/^[[:space:]]*"\([^"]*\)"[[:space:]]*-[[:space:]]*\(.*\)$/\1|\2/p'
}

validate_preset() {
    local preset=$1

    if ! list_configure_presets | cut -d '|' -f 1 | grep -Fxq "$preset"; then
        error "Preset not found: $preset"
        echo ""
        echo "Available presets:"
        list_configure_presets | sed 's/|/ - /; s/^/  /'
        exit 1
    fi
}

# Determine vcpkg feature from preset name
get_vcpkg_feature() {
    local preset=$1
    if [[ "$preset" == *"-yyjson"* ]]; then
        echo "yyjson"
    else
        echo "simdjson"
    fi
}

# Configure with CMake
configure_cmake() {
    local preset=$1
    local vcpkg_args=()

    if [[ "$USE_VCPKG" == true ]]; then
        local feature
        feature=$(get_vcpkg_feature "$preset")
        local toolchain_file="$VCPKG_DIR/scripts/buildsystems/vcpkg.cmake"

        vcpkg_args+=(
            "-DCMAKE_TOOLCHAIN_FILE=$toolchain_file"
            "-DVCPKG_MANIFEST_FEATURES=$feature"
        )

        # Check if preset uses a custom triplet that needs overlay
        local triplet
        triplet=$(get_preset_triplet "$preset")

        if [ -n "$triplet" ] && is_custom_triplet "$triplet"; then
            info "Preset uses custom triplet: $triplet"
            init_registry_submodule

            local registry_dir="$PROJECT_ROOT/extras/registry"
            vcpkg_args+=(
                "-DVCPKG_OVERLAY_TRIPLETS=$registry_dir/triplets"
                "-DVCPKG_OVERLAY_PORTS=$registry_dir/ports"
            )
            info "Using overlay registry for custom triplet"
        fi

        export VCPKG_HOME="$VCPKG_DIR"
        progress "Configuring with preset: $preset (vcpkg enabled, feature: $feature)"
    else
        progress "Configuring with preset: $preset (system deps)"
    fi

    if ! run_with_info_prefix cmake --fresh --preset "$preset" "${vcpkg_args[@]}" "${CMAKE_ARGS[@]}"; then
        die "CMake configuration failed"
    fi

    info "Configuration completed successfully"
}

# Build the project
build_project() {
    local preset=$1

    progress "Building project with preset: $preset"

    if ! run_with_info_prefix cmake --build --preset "$preset" --parallel; then
        die "Build failed"
    fi

    info "Build completed successfully"
}

# Main
main() {
    parse_args "$@"

    if [[ "$PRESET_MODE" == false ]]; then
        echo "========================================"
        echo "i18n-redis Configure & Build"
        echo "========================================"
        if [[ "$USE_VCPKG" == true ]]; then
            echo "Mode: Using vcpkg for dependencies"
        else
            echo "Mode: Using system packages (default)"
        fi
        echo ""
    fi

    # Check for required files
    if [[ ! -f "$PROJECT_ROOT/CMakeLists.txt" ]]; then
        die "CMakeLists.txt not found. Are you in the right directory?"
    fi

    if [[ ! -f "$PROJECT_ROOT/CMakePresets.json" ]]; then
        die "CMakePresets.json not found."
    fi

    # vcpkg operations only when --use-vcpkg is specified
    if [[ "$USE_VCPKG" == true ]]; then
        # Check git is installed (required for vcpkg)
        if ! command -v git &> /dev/null; then
            die "git is not installed. git is required to obtain vcpkg dependencies."
        fi

        # Check vcpkg.json exists
        if [[ ! -f "$PROJECT_ROOT/vcpkg.json" ]]; then
            die "vcpkg.json not found. Are you in the right directory?"
        fi

        if [ -d "$PROJECT_ROOT/.git" ]; then
            info "Project git repository detected at $PROJECT_ROOT/.git"
        else
            info "Project git repository not detected at $PROJECT_ROOT/.git"
        fi

        if [[ "$PRESET_MODE" == true ]]; then
            progress "Preparing vcpkg..."
        fi

        resolve_vcpkg

        # Bootstrap vcpkg
        bootstrap_vcpkg
    fi

    # Select preset
    if [[ -z "$PRESET" ]]; then
        select_preset_interactive
    else
        validate_preset "$PRESET"
    fi

    if [[ "$PRESET_MODE" == false ]]; then
        echo ""
        echo "Selected preset: $PRESET"
        echo ""
    fi

    # Configure
    configure_cmake "$PRESET"

    # Build (unless --configure-only)
    if [[ "$CONFIGURE_ONLY" == false ]]; then
        build_project "$PRESET"
        if [[ "$PRESET_MODE" == false ]]; then
            echo ""
            echo "========================================"
            echo "Build completed successfully!"
            echo "========================================"
            echo ""
            echo "To run tests: ctest --preset $PRESET"
            echo "To install:   cmake --install out/build --prefix <install_dir>"
        fi
    else
        if [[ "$PRESET_MODE" == false ]]; then
            echo ""
            echo "========================================"
            echo "Configuration completed (build skipped)"
            echo "========================================"
            echo ""
            echo "To build:     cmake --build --preset $PRESET"
            echo "To run tests: ctest --preset $PRESET"
        fi
    fi
}

# Run main
main "$@"
