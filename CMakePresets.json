{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "inherits": "vcpkg",
      "binaryDir": "${sourceDir}/out/build"
    },
    {
      "name": "vcpkg",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_HOME}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "VCPKG_TARGET_ARCHITECTURE": "x64"
      }
    },
    {
      "name": "backend-simdjson",
      "hidden": true,
      "cacheVariables": {
        "VCPKG_MANIFEST_FEATURES": "simdjson",
        "I18N_REDIS_JSON_BACKEND": "simdjson"
      }
    },
    {
      "name": "backend-yyjson",
      "hidden": true,
      "cacheVariables": {
        "VCPKG_MANIFEST_FEATURES": "yyjson",
        "I18N_REDIS_JSON_BACKEND": "yyjson"
      }
    },
    {
      "name": "base-ninja",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja"
    },
    {
      "name": "base-windows",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja"
    },
    {
      "name": "base-linux",
      "hidden": true,
      "inherits": "base-ninja"
    },
    {
      "name": "base-macos",
      "hidden": true,
      "inherits": "base-ninja"
    },
    {
      "name": "base-static",
      "hidden": true,
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF"
      }
    },
    {
      "name": "base-shared",
      "hidden": true,
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "cfg-debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "cfg-release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "cfg-relwithdebinfo",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "cfg-minsizerel",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "opt-lto",
      "hidden": true,
      "cacheVariables": {
        "I18N_REDIS_ENABLE_LTO": "ON"
      }
    },
    {
      "name": "opt-asan",
      "hidden": true,
      "cacheVariables": {
        "I18N_REDIS_ENABLE_ASAN": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "opt-ubsan",
      "hidden": true,
      "cacheVariables": {
        "I18N_REDIS_ENABLE_UBSAN": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "opt-dev",
      "hidden": true,
      "cacheVariables": {
        "I18N_REDIS_BUILD_EXAMPLES": "ON",
        "I18N_REDIS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "compiler-msvc",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "compiler-gcc",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_COMPILER_AR": "ar",
        "CMAKE_CXX_COMPILER_RANLIB": "ranlib"
      }
    },
    {
      "name": "compiler-clang",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_COMPILER_AR": "llvm-ar",
        "CMAKE_CXX_COMPILER_RANLIB": "llvm-ranlib"
      }
    },
    {
      "name": "triplet-linux-static",
      "hidden": true,
