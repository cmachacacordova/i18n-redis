@PACKAGE_INIT@
include(CMakeFindDependencyMacro)

find_dependency(redis++ CONFIG)
find_dependency(fmt CONFIG)

if (NOT DEFINED I18N_REDIS_JSON_BACKEND)
    set(I18N_REDIS_JSON_BACKEND "@I18N_REDIS_JSON_BACKEND@")
endif()

if (I18N_REDIS_JSON_BACKEND STREQUAL "simdjson")
    find_dependency(simdjson CONFIG)
elseif(I18N_REDIS_JSON_BACKEND STREQUAL "yyjson")
    find_dependency(yyjson CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/i18n-redisTargets.cmake")
